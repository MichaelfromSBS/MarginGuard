{
  "name": "MarginGuard demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "22" } },
  "postCreateCommand": "python scripts/demo.py --prepare-only",
  "postStartCommand": "nohup python scripts/demo.py --no-browser > /tmp/marginguard-demo.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "MarginGuard", "onAutoForward": "openBrowserOnce" }
  },
  "customizations": { "vscode": { "settings": { "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python" } } }
}
