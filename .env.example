# No API key is needed in mock mode. Mock output is a fixture, not AI analysis.
AI_MODE=mock
OPENROUTER_API_KEY=
# Copy a current model ID from https://openrouter.ai/models .
# Structured mode needs structured_outputs support; images also need image input.
OPENROUTER_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1800
# Relative paths resolve from the project root; demo seed is explicit, never automatic.
MARGINGUARD_DATABASE_PATH=data/marginguard.db
MARGINGUARD_UPLOAD_DIRECTORY=data/uploads
MARGINGUARD_EXTRACTION_MAX_OUTPUT_TOKENS=6000
MARGINGUARD_PROCESSING_MODE=worker
MARGINGUARD_INBOX_DIRECTORY=inbox
MARGINGUARD_WORKER_POLL_SECONDS=2
MARGINGUARD_FILE_STABLE_SECONDS=2
MARGINGUARD_ALERT_AI_EXPLANATIONS=true
MARGINGUARD_EXTRACTION_MAX_ATTEMPTS=3
# Configurable demo policies, not restaurant standards.
MARGINGUARD_SALES_DROP_PCT=30
MARGINGUARD_SALES_DROP_MIN_UNITS=10
